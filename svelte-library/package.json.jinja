{
    "name": "{{ name }}",
    "version": "0.0.1",
    "description": "{{ description }}",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "svelte-package",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."{% if tests %},
        "test": "vitest"{% endif %}
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "devDependencies": {
        "@eslint/compat": "2.1.1",
        "@eslint/js": "^10.0.1",
        "@sveltejs/package": "2.5.8",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
{% if tailwind %}        "@tailwindcss/vite": "4.3.3",
{% endif %}        "@types/node": "22.20.5",
{% if browser_tests %}        "@vitest/browser-playwright": "4.1.12",
{% endif %}{% if svelte_m3c %}        "bits-ui": "2.20.2",
{% endif %}        "eslint": "10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "5.13.0",
        "eslint-plugin-svelte": "3.23.1",
        "globals": "17.14.0",
{% if browser_tests %}        "playwright": "1.64.1",
{% endif %}        "prettier": "3.9.10",
        "prettier-plugin-svelte": "3.5.2",
{% if tailwind %}        "prettier-plugin-tailwindcss": "0.8.1",
{% endif %}{% if svelte_m3c %}        "svelte-m3c": "^0.0.5",
        "tailwind-merge": "3.7.0",
        "tailwind-variants": "3.3.1",
{% endif %}        "svelte": "5.57.3",
        "svelte-check": "4.7.7",
{% if tailwind %}        "tailwindcss": "4.3.3",
{% endif %}        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.5"{% if tests %},
        "vitest": "4.1.12"{% endif %}
    },
    "packageManager": "pnpm@11.28.10"
}
