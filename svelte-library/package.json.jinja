{
    "name": "{{ name }}",
    "version": "0.0.1",
    "description": "{{ description }}",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "svelte-package",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."{% if tests %},
        "test": "vitest"{% endif %}
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/package": "3.0.2",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
{% if tailwind %}        "@tailwindcss/vite": "^4.2.4",
{% endif %}        "@types/node": "26.6.6",
{% if browser_tests %}        "@vitest/browser-playwright": "5.0.5",
{% endif %}{% if svelte_m3c %}        "bits-ui": "^2.18.0",
{% endif %}        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.9.0",
        "eslint-plugin-svelte": "^3.5.1",
        "globals": "^17.6.0",
{% if browser_tests %}        "playwright": "^1.59.1",
{% endif %}        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "4.1.1",
{% if tailwind %}        "prettier-plugin-tailwindcss": "^0.8.0",
{% endif %}{% if svelte_m3c %}        "svelte-m3c": "^0.0.5",
        "tailwind-merge": "^3.5.0",
        "tailwind-variants": "4.0.1",
{% endif %}        "svelte": "^5.55.5",
        "svelte-check": "^4.4.7",
{% if tailwind %}        "tailwindcss": "^4.2.4",
{% endif %}        "typescript": "7.0.2",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.10"{% if tests %},
        "vitest": "5.0.5"{% endif %}
    },
    "packageManager": "pnpm@12.16.1"
}
