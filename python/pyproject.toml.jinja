[project]
name = "{{ name }}"
version = "0.0.1"
description = "{{ description }}"
requires-python = ">=3.13"
readme = "README.md"
license = { text = "GPL-3.0-or-later" }
dependencies = []
{% if cli %}
[project.scripts]
{{ name }} = "{{ name | replace('-', '_') }}.cli:main"
{% endif %}

[project.optional-dependencies]
dev = [
    "pyright==1.1.414",
    "pytest==9.1.1",
    "ruff==0.16.9",
    "tox==4.64.4",
]

[dependency-groups]
dev = [
    "pyright==1.1.414",
    "pytest==9.1.1",
    "ruff==0.16.9",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ name | replace('-', '_') }}"]

[tool.ruff]
line-length = 88
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP"]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.pyright]
include = ["src"]
exclude = ["tests"]
pythonVersion = "3.13"
strict = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]

[tool.tox]
legacy_tox_ini = """
[tox]
envlist = py313, lint, type
isolated_build = true

[testenv]
deps = pytest==9.1.1
commands = pytest {posargs}

[testenv:lint]
deps = ruff==0.16.9
commands = ruff check .

[testenv:type]
deps = pyright==1.1.414
commands = pyright
"""
