{
    "name": "{{ name }}",
    "version": "0.0.1",
    "description": "{{ description }}",
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "check": "tsc --noEmit",
        "build": "tsc",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "gen": "pnpm run gen:cf-types",
        "gen:cf-types": "wrangler types"{% if tests %},
        "test": "vitest"{% endif %}
    },
    "dependencies": {
        "hono": "^4.12.0"
    },
    "devDependencies": {
{% if tests %}        "@cloudflare/vitest-pool-workers": "^0.16.9",
{% endif %}        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.0.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.9.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
{% if tests %}        "vitest": "^4.1.7",
{% endif %}        "wrangler": "^4.94.0"
    },
    "packageManager": "pnpm@11.2.2"
}
