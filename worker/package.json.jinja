{
    "name": "{{ name }}",
    "version": "0.0.1",
    "description": "{{ description }}",
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "check": "tsc --noEmit",
        "build": "tsc",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "gen": "pnpm run gen:cf-types",
        "gen:cf-types": "wrangler types"{% if tests %},
        "test": "vitest"{% endif %}
    },
    "dependencies": {
        "hono": "4.13.16"
    },
    "devDependencies": {
{% if tests %}        "@cloudflare/vitest-pool-workers": "0.23.0",
{% endif %}        "@eslint/compat": "2.1.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "22.20.5",
        "eslint": "10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "5.13.0",
        "globals": "17.14.0",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
{% if tests %}        "vitest": "4.1.12",
{% endif %}        "wrangler": "4.156.0"
    },
    "packageManager": "pnpm@11.28.10"
}
