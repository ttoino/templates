{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "{{ name }}",
    "compatibility_date": "2026-05-24",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "preview_urls": true,
    "previews": {},
    "assets": {
        "directory": "public",
        "not_found_handling": "none",
    },
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
        },
        "traces": {
            "enabled": true,
        },
    },
}
