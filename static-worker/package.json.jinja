{
    "name": "{{ name }}",
    "version": "0.0.1",
    "description": "{{ description }}",
{%- if github_user %}
    "repository": {
        "type": "git",
        "url": "git+https://github.com/{{ github_user }}/{{ name }}.git"
    },
    "homepage": "https://github.com/{{ github_user }}/{{ name }}",
    "bugs": "https://github.com/{{ github_user }}/{{ name }}/issues",
{%- endif %}
    "type": "module",
    "scripts": {
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "devDependencies": {
        "prettier": "3.9.10",
        "wrangler": "4.156.0"
    },
    "packageManager": "pnpm@11.28.10"
}
