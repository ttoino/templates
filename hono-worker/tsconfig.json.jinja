    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "module": "es2022",
        "moduleResolution": "bundler"
    },
    "exclude": ["tests"],
    "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
